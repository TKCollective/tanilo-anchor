# Copy to .env (git-ignored) for local runs of the scripts in this repository.
ANCHOR_CHAIN=goat-testnet3
GOAT_RPC_URL=https://rpc.testnet3.goat.network
# The existing testnet3 contract. Printed by `npm run deploy` when you deploy a new one.
TANILO_ANCHOR_CONTRACT=0x801fB569593ae8fd9E906059cA6d9e584F4Bc30b
# A dedicated anchoring key, used for nothing else. Never paste it in chat, a commit or an issue.
GOAT_ANCHOR_PRIVATE_KEY=
ANCHOR_MAX_LEAVES=1000
